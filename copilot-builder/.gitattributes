# .gitattributes — line endings, first and unconditionally.
#
# The repository is developed on Windows, macOS and Linux and its content is plain text that gets
# compared, hashed and diffed. Without this, git writes CRLF into the working tree on Windows,
# every diff shows whole files as changed, and `biome format` disagrees with what is committed.
# One `text=auto eol=lf` rule removes the entire class of problem.

* text=auto eol=lf

# Classes of files that must stay LF even when the `auto` heuristic gets it wrong.
*.md        text eol=lf
*.mjs       text eol=lf
*.mts       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.sh        text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf
.githooks/*    text eol=lf

# Windows-only launchers keep CRLF — cmd.exe misreads LF batch files.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Generated files: LF, collapsed in review (GitLab reads `gitlab-generated`, GitHub `linguist-generated`).
package-lock.json text eol=lf -diff linguist-generated=true gitlab-generated=true
CODE-INDEX.md     text eol=lf linguist-generated=true gitlab-generated=true

# Binaries — never touched by line-ending conversion.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.7z    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
