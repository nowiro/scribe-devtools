{
  // ───────────────────────────── Kontekst always-on: co dokleja się do każdego żądania
  // AGENTS.md jest świadomie always-on (komendy, roster, granice). Zagnieżdżone AGENTS.md wyłączone —
  // jeden plik w korzeniu, jedno miejsce do przeglądu. CLAUDE.md wyłączony: repozytorium wspiera
  // wyłącznie Copilota, a repo z dwoma plikami płaci dwa razy.
  "chat.useAgentsMdFile": true,
  "chat.useClaudeMdFile": false,
  "chat.useNestedAgentsMdFiles": false,
  "chat.includeApplyingInstructions": true,
  "chat.includeReferencedInstructions": false,
  "chat.useCustomizationsInParentRepositories": false,

  // ───────────────────────────── Miejsca wykrywania: jawnie, jeden katalog na rodzaj
  // Przypięcie lokalizacji powstrzymuje VS Code przed ładowaniem kopii z profilu użytkownika — to,
  // co waliduje brama `npm run ai:validate`, jest tym, co się uruchamia.
  "chat.instructionsFilesLocations": { ".github/instructions": true },
  "chat.promptFilesLocations": { ".github/prompts": true },
  "chat.agentFilesLocations": { ".github/agents": true },
  "chat.agentSkillsLocations": { ".github/skills": true },
  "chat.hookFilesLocations": { ".github/hooks": true },
  "chat.promptFilesRecommendations": [],
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,

  // ───────────────────────────── Pętla agenta i punkty kontrolne
  // Roster jest płaski: `orchestrator` deleguje jeden poziom w dół i nikt nie deleguje dalej.
  // Limit żądań na turę: jedna pętla implement to kilkadziesiąt wywołań `npm run sdd` i briefów;
  // 25 przerywało ją pytaniem o kontynuację w połowie zadania.
  "chat.agent.maxRequests": 60,
  "chat.subagents.allowInvocationsFromSubagents": false,
  "chat.checkpoints.enabled": true,
  "chat.checkpoints.showFileChanges": true,
  "chat.useCustomAgentHooks": true,

  // ───────────────────────────── MCP: zero automatycznego wykrywania.
  // Serwery są zadeklarowane wyłącznie w .vscode/mcp.json tego repozytorium i używa ich jeden
  // ukryty subagent (`mcp-gateway`); żaden inny agent nie ma ich na liście `tools:`, więc schematy
  // narzędzi nie wchodzą do sesji głównej. Do ALM (Jira, GitLab, Confluence) i przeglądarki służą
  // skrypty (`npm run alm:read`, `npm run browser-inspector`), nie serwery.
  "chat.mcp.discovery.enabled": {
    "claude-desktop": false,
    "windsurf": false,
    "cursor-global": false,
    "cursor-workspace": false
  },

  // ───────────────────────────── Zatwierdzanie narzędzi: bramy, skrypty SDD i odczyt gita bez kliknięcia
  // Każda komenda z tej listy jest deterministyczna, nie wychodzi do sieci i nie zmienia niczego poza
  // artefaktami SDD w docs/ albo cache'em. Komendy, które dotykają sieci albo przeglądarki (alm:read,
  // browser-inspector, check:upstream), zostają za kliknięciem człowieka.
  "chat.tools.global.autoApprove": false,
  "chat.tools.terminal.autoApprove": {
    "npm run verify": true,
    "npm run verify:affected": true,
    "npm run lint": true,
    "npm run test": true,
    "npm run typecheck": true,
    "npm run build": true,
    "npm run format:check": true,
    "npm run ai:validate": true,
    "npm run sdd:check": true,
    "npm run sdd": true,
    "npm run route": true,
    "npm run review:draw": true,
    "npm run review:merge": true,
    "npm run workflow:specify": true,
    "npm run stamp": true,
    "npm run check:pins": true,
    "npm run check:instructions": true,
    "npm run check:prefix": true,
    "npm run check:glossary": true,
    "npm run guard:forbidden": true,
    "npm run stack:check": true,
    "npm run code-index": true,
    "npm run affected": true,
    "npm run doctor": true,
    "git status": true,
    "git diff": true,
    "git log": true
  },
  // Odmowa dla wszystkiego, co auto-zatwierdzona komenda terminala WYKONUJE jako kod (konfiguracje
  // oxlint/ESLint/Vitest/oxfmt/commitlint, angular.json, tools/**) i dla plików, które definiują same kontrole
  // (.vscode, .github, hooki, manifest, lockfile). Zasada: plik ładowany przez komendę z listy powyżej
  // nigdy nie jest edytowany bez kliknięcia człowieka. Ryzyko rezydualne, zapisane świadomie: pliki
  // `*.spec.ts` w apps/ i libs/ (tester musi je pisać) — `npm run test` je wykonuje.
  "chat.tools.edits.autoApprove": {
    // Everything an auto-approved terminal command EXECUTES (oxlint, ESLint, Vitest, oxfmt, commitlint and
    // Angular read their configuration as code) and everything that DEFINES the controls themselves.
    "**/tools/hooks/**": false,
    "**/tools/scripts/**": false,
    "**/tools/testing/**": false,
    "**/.github/**": false,
    "**/.githooks/**": false,
    "**/.vscode/**": false,
    "AGENTS.md": false,
    "package.json": false,
    "package-lock.json": false,
    ".npmrc": false,
    ".nvmrc": false,
    ".gitignore": false,
    ".gitattributes": false,
    ".gitlab-ci.yml": false,
    "angular.json": false,
    ".oxfmtrc.jsonc": false,
    "commitlint.config.mjs": false,
    "eslint.config.mjs": false,
    "oxlint.config.mts": false,
    "oxlint.plugins.mts": false,
    "oxlint.rules.mts": false,
    "tsconfig.json": false,
    "tsconfig.tools.json": false,
    "vitest.tools.config.mts": false
  },

  // ───────────────────────────── Indeks i wyszukiwanie: szum zostaje poza
  "github.copilot.chat.codesearch.enabled": false,
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/.angular": true,
    "**/.cache": true,
    "**/.alm": true,
    "**/.browser-inspector": true,
    "**/.mcp-artifacts": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/.angular": true,
    "**/.cache": true,
    "**/.alm": true,
    "**/.browser-inspector": true,
    "**/.mcp-artifacts": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "package-lock.json": true,
    "CODE-INDEX.md": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.angular/**": true,
    "**/.cache/**": true,
    "**/.alm/**": true,
    "**/.browser-inspector/**": true
  },
  "npm.autoDetect": "off",
  "typescript.tsc.autoDetect": "off",

  // ───────────────────────────── Higiena edytora: sformatowany plik nie wywraca bramy
  // oxfmt formatuje TS/JS/JSON/CSS/YAML i szablony HTML. Markdown zostaje bez formatera z wyboru
  // (.oxfmtrc.jsonc mówi dlaczego) — dla niego obowiązuje tylko EditorConfig: LF, spacje, finalna nowa linia.
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[markdown]": {
    "editor.defaultFormatter": null,
    "editor.formatOnSave": false,
    "files.trimTrailingWhitespace": false
  },
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,

  // ───────────────────────────── TypeScript, oxlint i ESLint z repozytorium, nie z edytora
  // Angular 22 wymaga TypeScript 6.0.x; edytor ma pokazywać to samo, co bramka `tsc`.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.includePackageJsonAutoImports": "off",
  "js/ts.implicitProjectConfig.checkJs": true,
  // oxlint czyta oxlint.config.mts (typeAware stamtąd); ESLint ma tylko reguły Angulara, więc
  // sprawdza wyłącznie TypeScript i szablony.
  "eslint.useFlatConfig": true,
  "eslint.validate": ["typescript", "html"],
  "eslint.options": { "cache": true, "cacheLocation": ".cache/eslint/" },
  "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit", "source.fixAll.eslint": "explicit" },

  // ───────────────────────────── Testy siedzą obok modułów — zagnieżdżaj je w eksploratorze
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.spec.ts, ${capture}.html, ${capture}.css",
    "*.mjs": "${capture}.spec.mjs",
    "package.json": "package-lock.json, .npmrc, .nvmrc",
    "tsconfig.json": "tsconfig.*.json",
    "angular.json": ".oxfmtrc.jsonc, commitlint.config.mjs, eslint.config.mjs, oxlint.config.mts, oxlint.plugins.mts, oxlint.rules.mts, vitest.tools.config.mts"
  }
}
