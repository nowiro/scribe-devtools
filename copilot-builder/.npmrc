# .npmrc — four lines, all about failing loudly and installing quietly.

# No dependency runs its own lifecycle script at `npm install`. Explicit `npm run <script>` calls are
# unaffected, but so is `prepare`: hooks are armed by an explicit `npm run prepare` after the first
# install (documented in README.md). Packages with native binaries (esbuild, oxfmt, oxlint, lightningcss)
# resolve them through optional platform packages, not through install scripts, so nothing breaks.
ignore-scripts=true

# `engines.node` is a requirement, not a hint. Without this line npm prints a warning and continues,
# and the failure surfaces later as a syntax error in somebody else's file.
engine-strict=true

# Install noise off: the vulnerability audit runs as the nightly `audit` job in .gitlab-ci.yml
# (`npm audit --audit-level=high --omit=dev`), not on every install; `check:upstream` reports lag only.
audit=false
fund=false
