# Dependencies and build output. `node_modules/` and `dist/` are unanchored on purpose — no project
# keeps hand-written code in a folder of either name. The rest are ANCHORED to the repository root,
# because that is the only place this template writes them (tools/testing/vitest-angular.config.mts
# → `coverage/<projekt>`, tools/scripts/new-project.mjs → `../../test-results/<nazwa>`), while
# `coverage`, `out-tsc`, `reports`, `tmp` and `test-results` are ordinary FEATURE folder names deeper
# inside `src/`. Unanchored, they silently kept such a folder out of git — and a file git never sees
# is a file `affected` never selects, whatever the dependency graph says.
node_modules/
dist/
/out-tsc/
/coverage/
*.log
*.tsbuildinfo
.DS_Store
Thumbs.db

# Caches — the whole point of `.cache/` is to be one directory GitLab CI can restore
# (Angular CLI build cache, ESLint cache, tsc incremental state, Vite/Vitest cache, task hashes).
.angular/
.cache/
.eslintcache
.vitest/

# Test artefacts (Playwright reports, traces, screenshots of failed runs)
/playwright-report/
/test-results/
/reports/
/blob-report/

# Output of every `npm run alm:read` and `npm run browser-inspector` run: what lands there is
# upstream customer data (issue descriptions, comments, page bodies) or somebody's application
# under inspection. Reproducible with one command, so it earns no place in history — and git does
# not forget, so getting it back out would mean rewriting every clone.
.alm/
.browser-inspector/
# Artefacts handed back by the MCP integration subagent — same rule, same reason.
.mcp-artifacts/

# A read config carries YOUR JQL, project keys, page ids and browser flows — the committed
# examples in tools/alm/examples/ name a placeholder project and pull nothing.
read.config.*.json
!tools/alm/examples/read.config.*.json

# SDD artefacts are local-only by policy (docs/sdd/methodology.md): specs, plans and run-logs are
# working material of one task, not documentation of the project. Only the directory markers stay.
docs/specs/*
!docs/specs/.gitkeep
docs/plans/*
!docs/plans/.gitkeep
docs/runs/*
!docs/runs/.gitkeep

# Scratch space of hooks and agents (handoff notes, ledgers). Anchored for the reason above.
/tmp/

# Other assistants' configuration: this repository supports GitHub Copilot only (guard:forbidden
# fails on any of these, the ignore just keeps a local experiment out of `git add .`).
CLAUDE.md
.claude/
.cursor/
.codex/
.mcp.json

# Secrets never live in the repository: environment or ~/.config only (tools/scripts/check-secrets.mjs
# looks at every commit). Local .env files and key material stay out of git by name as well.
.env
.env.*
!.env.example
*.pem
*.key
