#!/bin/sh
# pre-commit — the cheap gate that cannot be forgotten. Under a few seconds, no network, no build:
# a hook that takes a minute gets bypassed with --no-verify, and then it checks nothing.
#
#   1. Nothing that looks like a credential enters history (staged additions only).
#   2. CODE-INDEX.md and the tech-stack canon are regenerated FROM THE STAGED TREE and staged, so the
#      commit carries an index of the code it contains — not of half-staged edits in the working tree.
#      (`npm run verify` fails on a stale one; this makes staleness impossible.)
#   3. oxfmt checks the STAGED files only — formatting is a rule a machine enforces, not a review remark.
#      oxfmt has no `--staged`: git lists the files, NUL-separated so a space in a name survives, and
#      oxfmt skips what .oxfmtrc.jsonc ignores or cannot parse.
#   4. The Copilot configuration is validated — a typo in `applyTo` or a model name outside the
#      registry is invisible in a diff and visible only when an agent misbehaves.
#
# Armed by `npm run prepare` (core.hooksPath = .githooks). The full gate is `npm run verify`.
set -e
node tools/scripts/check-secrets.mjs
node tools/scripts/index-code.mjs --staged
git add CODE-INDEX.md
node tools/scripts/stack.mjs sync
git add docs/tech-stack.md
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r node node_modules/oxfmt/bin/oxfmt --check --no-error-on-unmatched-pattern
node tools/scripts/validate-ai-config.mjs
