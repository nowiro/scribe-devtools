{
  // Minimum, które odtwarza bramki repo w edytorze: Biome (biome.jsonc) na kodzie i JSON-ie,
  // prettier (prettier.config.mjs) na Markdownie — obie bramki są w `pnpm run verify` — oraz
  // Copilot Chat z prompt files (.github/prompts) i instrukcjami (.github/instructions).
  // EditorConfig trzyma LF, spacje i finalną nową linię tam, gdzie nie sięga żaden z formaterów.
  "recommendations": [
    "biomejs.biome",
    "esbenp.prettier-vscode",
    "GitHub.copilot",
    "GitHub.copilot-chat",
    "EditorConfig.EditorConfig"
  ]
}
