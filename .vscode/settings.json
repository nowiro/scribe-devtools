{
  // Formatowanie: jedna konfiguracja dla całego repo (prettier.config.mjs, 120 kolumn, LF).
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "[markdown]": { "files.trimTrailingWhitespace": false },

  // Wyniki przebiegów to dane cudzej aplikacji — nie indeksuj ich i nie pokazuj w wyszukiwaniu.
  "files.exclude": { "**/.scribe-devtools": true, "**/bench/out": true },
  "search.exclude": { "**/.scribe-devtools": true, "**/bench/out": true, "**/download": true, "**/node_modules": true },
  "files.watcherExclude": { "**/.scribe-devtools/**": true, "**/bench/out/**": true },

  // GitHub Copilot: instrukcje repo (.github/copilot-instructions.md, .github/instructions/*.instructions.md),
  // prompt files (.github/prompts/*.prompt.md → /migrate-from-mcp-playwright, /browser-session) i AGENTS.md.
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "chat.promptFilesLocations": { ".github/prompts": true },
  "chat.instructionsFilesLocations": { ".github/instructions": true },
  "chat.useAgentsMdFile": true,

  // Vitest: projekty unit/scripts/bench/smoke/compat z vitest.config.mts; smoke i compat wymagają Chrome/Edge.
  "vitest.rootConfig": "vitest.config.mts",

  // Typy z JSDoc sprawdza tsc --checkJs (tsconfig.json) — edytor ma pokazywać to samo, co bramka.
  "js/ts.implicitProjectConfig.checkJs": true,
  "typescript.tsdk": "node_modules/typescript/lib"
}
