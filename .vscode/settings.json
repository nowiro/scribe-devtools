{
  // Formatowanie: kod i JSON pilnuje Biome (biome.jsonc), prozę prettier (prettier.config.mjs) —
  // dwa formatery nad rozłącznymi zbiorami plików, bo Biome nie ma formatera Markdownu.
  "editor.defaultFormatter": "biomejs.biome",

  // Zadania typu `npm` w tasks.json mają jechać pnpm — inaczej Run Task wołałby npm w repo,
  // które npm-locka już nie ma.
  "npm.packageManager": "pnpm",
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  // Markdown idzie przez prettiera — tego samego, którym bramka robi `prettier --check "**/*.md"`,
  // żeby zapis w edytorze i bramka dawały ten sam plik. Przycinanie spacji zostaje wyłączone: "dwie
  // spacje na końcu = łamanie linii" jest w review niewidoczne i nie przeżywa przycinania.
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "files.trimTrailingWhitespace": false },

  // Wyniki przebiegów narzędzi to dane cudzej aplikacji/workspace'a — nie indeksuj ich i nie
  // pokazuj w wyszukiwaniu.
  "files.exclude": { "**/.scribe-devtools": true, "**/.ws": true },
  "search.exclude": { "**/.scribe-devtools": true, "**/.ws": true, "**/download": true, "**/node_modules": true },
  "files.watcherExclude": { "**/.scribe-devtools/**": true, "**/.ws/**": true },

  // GitHub Copilot: instrukcje repo (.github/copilot-instructions.md, .github/instructions/*.instructions.md),
  // prompt files (.github/prompts/*.prompt.md → /migrate-from-mcp-playwright, /browser-session) i AGENTS.md.
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "chat.promptFilesLocations": { ".github/prompts": true },
  "chat.instructionsFilesLocations": { ".github/instructions": true },
  "chat.useAgentsMdFile": true,

  // Typy z JSDoc sprawdza tsc --checkJs (tsconfig.json) — edytor ma pokazywać to samo, co bramka.
  "js/ts.implicitProjectConfig.checkJs": true,
  "typescript.tsdk": "node_modules/typescript/lib"
}
