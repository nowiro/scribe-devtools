{
  // Zadania = skrypty z package.json, żeby VS Code (Terminal → Run Task) i Copilot w trybie agent
  // uruchamiały dokładnie te same bramki, co człowiek z konsoli. Nic tu nie omija hooków.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "verify (wszystkie bramki)",
      "type": "npm",
      "script": "verify",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "test (vitest, bez przeglądarki)",
      "type": "npm",
      "script": "test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "smoke (prawdziwy Chrome/Edge)",
      "type": "npm",
      "script": "smoke",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "bench (browser-inspector vs @playwright/mcp — długie)",
      "type": "npm",
      "script": "bench",
      "problemMatcher": []
    },
    { "label": "portable (zip do download/)", "type": "npm", "script": "portable", "problemMatcher": [] },
    {
      "label": "docs (STEPS.md) + code-index",
      "type": "shell",
      "command": "npm run docs && npm run code-index",
      "problemMatcher": []
    },
    {
      "label": "browser-inspector: doctor",
      "type": "shell",
      "command": "node packages/browser-inspector/bin/browser-inspector.mjs doctor",
      "problemMatcher": []
    },
    {
      "label": "browser-inspector: up (ciepły keeper na czas sesji)",
      "type": "shell",
      "command": "node packages/browser-inspector/bin/browser-inspector.mjs up",
      "problemMatcher": []
    },
    {
      "label": "browser-inspector: stop",
      "type": "shell",
      "command": "node packages/browser-inspector/bin/browser-inspector.mjs stop",
      "problemMatcher": []
    },
    {
      "label": "browser-inspector: batch z fixture (--no-daemon)",
      "type": "shell",
      "command": "node packages/browser-inspector/bin/browser-inspector.mjs packages/browser-inspector/fixtures/app-factory.config.json --no-daemon",
      "problemMatcher": []
    }
  ]
}
