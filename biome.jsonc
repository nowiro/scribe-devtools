{
  // biome.jsonc — ONE formatting configuration for the whole repository, successor of
  // prettier.config.mjs. The numbers are carried over unchanged (120 columns, LF, single quotes,
  // trailing commas everywhere), so the migration is a change of TOOL, not of style.
  //
  // `$schema` points at the copy inside node_modules on purpose: the published schema URL carries
  // the version in its path, which would be a SECOND place where the Biome version is declared —
  // and scripts/pins.config.mjs exists precisely so that there is only one.
  //
  // What Biome does NOT do here: it has no Markdown formatter (the 2.x configuration schema knows
  // css, graphql, grit, html, javascript and json — there is no markdown section), so the nine
  // Markdown files that prettier used to format (.github/**/*.md and templates/flow.md) are now
  // checked by review only. Named, not hidden; AGENTS.md says the same in the gate table.
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": false },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  // `.vscode/*.json` are JSONC with comments, and so is this file — without allowComments the
  // formatter would refuse them as malformed JSON.
  "json": {
    "parser": { "allowComments": true },
    "formatter": { "enabled": true }
  },
  // Biome ships a linter and an import sorter. Neither is part of this migration: the repository
  // deliberately has no linter (rules are carried by `tsc --checkJs` on JSDoc types and by review),
  // and organizing imports would rewrite files for a reason nobody asked for. Turning either on is
  // a project decision, not a side effect of changing formatter.
  "linter": { "enabled": false },
  "assist": { "enabled": false },
  // Twin of .prettierignore: what a human maintains by hand and what a generator writes.
  // The Markdown entries from that file are gone because Biome never looks at Markdown anyway.
  "files": {
    "includes": [
      "**",
      "!node_modules/**",
      "!coverage/**",
      "!package-lock.json",
      "!.scribe-devtools/**",
      "!.ws/**",
      "!download/**"
    ]
  }
}
