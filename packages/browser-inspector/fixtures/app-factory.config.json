{
  "outputDir": "./.scribe-devtools/browser-inspector",
  "snapshots": [
    {
      "name": "nowiro-strona",
      "type": "page",
      "url": "http://localhost:4311/",
      "waitUntil": "networkidle",
      "fullPage": true
    },
    {
      "name": "nowiro-jezyk",
      "type": "flow",
      "url": "http://localhost:4311/",
      "waitUntil": "networkidle",
      "steps": [
        { "do": "extract", "name": "naglowek-pl", "selector": "h1" },
        { "do": "click", "selector": "[data-testid=lang-en]" },
        { "do": "wait", "ms": 500 },
        { "do": "extract", "name": "naglowek-en", "selector": "h1" },
        {
          "do": "evaluate",
          "name": "jezyk-dokumentu",
          "expression": "document.documentElement.lang"
        },
        { "do": "screenshot", "name": "wersja-en" }
      ]
    },
    {
      "name": "wizard-formularz",
      "type": "flow",
      "url": "http://localhost:4312/",
      "waitUntil": "networkidle",
      "stepTimeoutMs": 8000,
      "steps": [
        { "do": "click", "selector": "[data-testid=dashboard-tile-1]" },
        { "do": "wait", "ms": 600 },
        {
          "do": "evaluate",
          "name": "krok-przed",
          "expression": "document.body.innerText.match(/krok \\d \\/ 6/)[0]"
        },
        { "do": "fill", "selector": "#mat-input-0", "value": "Nowiro Sp. z o.o." },
        { "do": "fill", "selector": "#mat-input-2", "value": "1234563218" },
        { "do": "fill", "selector": "#mat-input-3", "value": "123456785" },
        { "do": "fill", "selector": "#mat-input-4", "value": "0000123456" },
        { "do": "fill", "selector": "#mat-input-5", "value": "2010" },
        { "do": "fill", "selector": "#mat-input-6", "value": "https://nowiro.eu" },
        { "do": "click", "selector": "#cdk-stepper-0-label-1" },
        { "do": "wait", "ms": 700 },
        {
          "do": "evaluate",
          "name": "krok-po",
          "expression": "document.body.innerText.match(/krok \\d \\/ 6/)[0]"
        },
        { "do": "click", "selector": "[data-testid=shell-back-to-dashboard]" },
        { "do": "wait", "ms": 700 },
        {
          "do": "evaluate",
          "name": "status-kroku-1",
          "expression": "document.body.innerText.split('KROK 2')[0].includes('Gotowe') ? 'Gotowe' : 'NIEUKONCZONY'"
        },
        { "do": "screenshot", "name": "pulpit-po-kroku-1", "fullPage": true }
      ]
    },
    {
      "name": "bookstore-zakupy",
      "type": "flow",
      "url": "http://localhost:4313/",
      "waitUntil": "networkidle",
      "steps": [
        { "do": "fill", "selector": "#mat-input-0", "value": "Harry" },
        { "do": "click", "selector": "[data-testid=search-submit]" },
        { "do": "wait", "ms": 700 },
        { "do": "extract", "name": "pierwsza-karta", "selector": "ais-shop-product-card" },
        { "do": "click", "selector": "[data-testid=card-add-to-cart]" },
        { "do": "wait", "ms": 400 },
        {
          "do": "extract",
          "name": "przycisk-koszyka",
          "selector": "[data-testid=header-cart-button]"
        },
        { "do": "click", "selector": "[data-testid=header-cart-button]" },
        { "do": "wait", "ms": 600 },
        { "do": "screenshot", "name": "koszyk", "fullPage": true }
      ]
    },
    {
      "name": "dziennik-nauczyciel",
      "type": "flow",
      "url": "http://localhost:4314/",
      "steps": [
        { "do": "waitFor", "selector": "[data-testid=dashboard-anonymous]" },
        { "do": "click", "selector": "[data-testid=journal-login-select]" },
        { "do": "click", "selector": "mat-option:has-text('Ewa Lewandowska')" },
        { "do": "waitFor", "selector": "[data-testid=dashboard-teacher-grades]" },
        { "do": "extract", "name": "powitanie", "selector": "h1" },
        {
          "do": "extract",
          "name": "aktywny-profil",
          "selector": "[data-testid=journal-login-active]"
        },
        { "do": "screenshot", "name": "po-zalogowaniu-nauczyciel" }
      ]
    },
    {
      "name": "dziennik-uczen",
      "type": "flow",
      "url": "http://localhost:4314/",
      "steps": [
        { "do": "waitFor", "selector": "[data-testid=dashboard-anonymous]" },
        { "do": "click", "selector": "[data-testid=journal-login-select]" },
        { "do": "click", "selector": "mat-option:has-text('Anna Kowalska')" },
        { "do": "waitFor", "selector": "[data-testid=dashboard-grades]" },
        { "do": "extract", "name": "powitanie", "selector": "h1" },
        {
          "do": "extract",
          "name": "aktywny-profil",
          "selector": "[data-testid=journal-login-active]"
        },
        {
          "do": "evaluate",
          "name": "uprawnienia-ucznia",
          "expression": "(() => { const n = document.querySelectorAll('[data-testid=dashboard-teacher-grades]').length; if (n !== 0) throw new Error('uczen widzi przycisk nauczyciela'); return 'brak przycisku nauczyciela'; })()"
        },
        { "do": "screenshot", "name": "po-zalogowaniu-uczen" }
      ]
    }
  ]
}
