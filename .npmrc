# .npmrc — two lines, both about failing loudly.

# No dependency runs its own lifecycle script at `pnpm install` — the same "zero lifecycle
# scripts" rule that `onlyBuiltDependencies: []` cemented in the pnpm era. Explicit
# `pnpm run <script>` invocations are unaffected, but pre/post hooks (`preextract`, …) are
# skipped too — which is why `package.json` chains steps with `&&` instead of hooks.
ignore-scripts=true

# `engines.node >= 22` is a requirement, not a hint. Without this line the install prints a
# warning and continues, and the failure surfaces later as a syntax error in somebody else's file.
# The file keeps the name `.npmrc` after the move to pnpm: pnpm reads it, and renaming it would
# only hide the settings from anyone who still reaches for npm by habit.
engine-strict=true
