# .npmrc — two lines, both about failing loudly.

# No dependency runs its own lifecycle script at `npm install` — the same "zero lifecycle
# scripts" rule that `onlyBuiltDependencies: []` cemented in the pnpm era. Explicit
# `npm run <script>` invocations are unaffected, but pre/post hooks (`preextract`, …) are
# skipped too — which is why `package.json` chains steps with `&&` instead of hooks.
ignore-scripts=true

# `engines.node >= 22` is a requirement, not a hint. Without this line npm prints a warning
# and continues, and the failure surfaces later as a syntax error in somebody else's file.
engine-strict=true
