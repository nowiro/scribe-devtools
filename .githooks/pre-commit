#!/bin/sh
# Regenerates every generated artifact so each commit carries them fresh — `npm run verify` fails
# on a stale one, this hook makes staleness impossible. Armed by `npm run prepare` (`.npmrc` has
# ignore-scripts=true, so `npm install` does NOT run `prepare` — call it once).
#
# Order: code index → steps doc → portable zip. The zip build is deterministic (fixed timestamps,
# sorted entries, sha256 sidecar), so when nothing inside changed the file is byte-identical and
# `git add` is a no-op — a commit that touches only docs does not grow history by 3 MB.
node scripts/index-code.mjs || exit 1
git add CODE-INDEX.md
# docs/STEPS.md exists only once packages/browser-inspector/src/steps.schema.mjs does; the
# generator says so and exits 0 in the meantime.
node scripts/gen-steps-doc.mjs || exit 1
[ -f docs/STEPS.md ] && git add docs/STEPS.md
# download/scribe-devtools-portable-<version>.zip (+ .sha256): the version comes from package.json,
# every released version stays in the repository. Needs node_modules (npm ci) — the build says so.
node scripts/portable-zip.mjs || exit 1
git add download
exit 0
