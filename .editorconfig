# .editorconfig — three invariants the whole repository relies on: LF line endings, no
# trailing whitespace and exactly one newline at the end of every file. The editor should
# produce content that already satisfies them, so that opening a file in another tool never
# shows up as a diff.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# No formatter touches Markdown here (Biome has none and prettier is gone), so this file is
# the only thing keeping LF, spaces and a final newline in prose. No hard width limit: it
# would fight tables that were narrowed by hand. Trimming trailing whitespace stays on
# deliberately: the markdown "two trailing spaces = line break" is invisible in review.
max_line_length = off

[Makefile]
indent_style = tab
